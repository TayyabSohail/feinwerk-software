# App (required). Production domain: https://feinwerks.software
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Feinwerks Software

# Contact form delivery via Resend (https://resend.com) - required for the form to send.
# Without it, submissions are only logged on the server (and stored in Supabase if configured).
RESEND_API_KEY=
# Inbox that receives enquiries. Temporary until the company inbox exists.
CONTACT_TO_EMAIL=feinwerksoftware@gmail.com
# Must be a verified sender on your Resend domain. Until the domain is verified
# in Resend, use their shared sender: "Feinwerks Software <onboarding@resend.dev>"
CONTACT_FROM_EMAIL="Feinwerks Software <onboarding@resend.dev>"

# Supabase - optional. When set, contact submissions are stored in `contact_messages`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cal.com booking link as "username/event", e.g. feinwerk/intro - optional.
NEXT_PUBLIC_CAL_LINK=

# PostHog analytics - optional, only loads after cookie consent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
