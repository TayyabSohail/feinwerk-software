# App (required)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Feinwerk Software

# Contact form delivery via Resend (https://resend.com) - optional.
# Without it, submissions are logged on the server (and stored in Supabase if configured).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a verified sender on your Resend domain, e.g. "Feinwerk Software <hello@feinwerk.software>"
CONTACT_FROM_EMAIL=

# Supabase - optional. When set, contact submissions are stored in `contact_messages`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cal.com booking link as "username/event", e.g. feinwerk/intro - optional.
NEXT_PUBLIC_CAL_LINK=

# PostHog analytics - optional, only loads after cookie consent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
